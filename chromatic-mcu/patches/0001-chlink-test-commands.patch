diff --git a/main/chlink.c b/main/chlink.c
new file mode 100644
index 0000000..e4690f9
--- /dev/null
+++ b/main/chlink.c
@@ -0,0 +1,105 @@
+// ChromaSynth test commands (console over the USB serial port, 115200 bps):
+//   chver                 firmware identification
+//   sym <hex>             write the FPGA's MCU_buttons register directly (bits: 0 START, 1 SELECT, 2 B,
+//                         3 A, 4 UP, 5 RIGHT, 6 LEFT, 7 DOWN). "sym 0" releases everything.
+//   gpd [count [ms]]      ask the FPGA for the game palette data and print it (raw bytes as received
+//                         and the same bytes as OBJ palette 1 bytes 10..13 / BG palette 0 bytes 2..5)
+#include "chlink.h"
+
+#include "esp_console.h"
+#include "fpga_tx.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/semphr.h"
+#include "freertos/task.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static volatile bool s_want = false;
+static uint8_t s_gpd[8];
+static SemaphoreHandle_t s_sem = NULL;
+
+bool ChLink_OnGpd(const uint8_t *Payload, size_t Len)
+{
+    if (!s_want || Len != 8)
+    {
+        return false;
+    }
+    memcpy(s_gpd, Payload, 8);
+    s_want = false;
+    xSemaphoreGive(s_sem);
+    return true;
+}
+
+static int cmd_chver(int argc, char **argv)
+{
+    (void)argc;
+    (void)argv;
+    printf("chlink test firmware v0 (stock v4.6 + sym/gpd, console on USB)\n");
+    return 0;
+}
+
+static int cmd_sym(int argc, char **argv)
+{
+    if (argc != 2)
+    {
+        printf("usage: sym <hex mask>  (0 = release)\n");
+        return -1;
+    }
+    const long mask = strtol(argv[1], NULL, 16);
+    if (mask < 0 || mask > 0xFF)
+    {
+        printf("mask must be 00..FF (buttons only; the menu bits are not allowed here)\n");
+        return -1;
+    }
+    FPGA_Tx_RawPoke((uint16_t)mask);
+    printf("sym %02lX\n", mask);
+    return 0;
+}
+
+static int cmd_gpd(int argc, char **argv)
+{
+    int count = (argc >= 2) ? atoi(argv[1]) : 1;
+    int ms = (argc >= 3) ? atoi(argv[2]) : 100;
+    if (count < 1 || count > 1000 || ms < 5 || ms > 5000)
+    {
+        printf("usage: gpd [count 1..1000 [ms 5..5000]]\n");
+        return -1;
+    }
+    if (s_sem == NULL)
+    {
+        s_sem = xSemaphoreCreateBinary();
+    }
+    for (int i = 0; i < count; i++)
+    {
+        s_want = true;
+        (void)xSemaphoreTake(s_sem, 0);
+        FPGA_Tx_RequestBGPD();
+        if (xSemaphoreTake(s_sem, pdMS_TO_TICKS(500)) == pdTRUE)
+        {
+            printf("gpd %02X %02X %02X %02X %02X %02X %02X %02X\n", s_gpd[0], s_gpd[1], s_gpd[2], s_gpd[3],
+                   s_gpd[4], s_gpd[5], s_gpd[6], s_gpd[7]);
+        }
+        else
+        {
+            s_want = false;
+            printf("gpd timeout\n");
+        }
+        vTaskDelay(pdMS_TO_TICKS(ms));
+    }
+    return 0;
+}
+
+void ChLink_RegisterCommands(void)
+{
+    const esp_console_cmd_t cmds[] = {
+        {.command = "chver", .help = "chlink test firmware version", .func = &cmd_chver},
+        {.command = "sym", .help = "write the FPGA button register: sym <hex>", .func = &cmd_sym},
+        {.command = "gpd", .help = "read the game palette data: gpd [count [ms]]", .func = &cmd_gpd},
+    };
+    for (size_t i = 0; i < sizeof(cmds) / sizeof(cmds[0]); i++)
+    {
+        (void)esp_console_cmd_register(&cmds[i]);
+    }
+}
