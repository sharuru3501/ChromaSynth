@@ -237,6 +237,21 @@ void FPGA_Tx_PokeButtons(void)
    (void) xEventGroupSetBits(xEventGroupHandle, kTxFlag_PokeButton);
 }
 
+void FPGA_Tx_RawPoke(uint16_t Mask)
+{
+    uint8_t Buf[14] = {0};
+    const size_t Size = SetupTxBuffer(Buf, kTxCmd_PokeButton, sizeof(Mask), &Mask);
+    (void) uart_write_bytes(UART_NUM_1, Buf, Size);
+}
+
+void FPGA_Tx_RequestBGPD(void)
+{
+    if (xEventGroupHandle != NULL)
+    {
+        (void) xEventGroupSetBits(xEventGroupHandle, kTxFlag_RequestBGPD);
+    }
+}
+
 void FPGA_Tx_WritePaletteStyle(void)
 {
    (void) xEventGroupSetBits(xEventGroupHandle, kTxFlag_SetPaletteStyle);
