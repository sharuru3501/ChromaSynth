@@ -43,6 +44,13 @@ static const gpio_config_t WakeUpPin = {
 };
 
 static void IdleTimerCB( TimerHandle_t xTimer );
+static volatile bool s_ChlinkKeepAwake = false;
+
+void PwrMgr_ChlinkKeepAwake(const bool KeepAwake)
+{
+    s_ChlinkKeepAwake = KeepAwake;
+    PwrMgr_IdleTimerPet();   // (re)start the idle timer so that the stock light sleep resumes after the idle time
+}
 
 void PwrMgr_Task(void *arg)
 {
@@ -104,10 +112,19 @@ void PwrMgr_Task(void *arg)
 
 void PwrMgr_TriggerLightSleep(void)
 {
-    // chlink: stay awake. In light sleep the CPU is stopped (no timers, no tasks, no console input);
-    // only a message from the FPGA wakes it, so the MCU could neither poll the game's palette data
-    // nor send virtual buttons while a game runs. Costs battery life; make it conditional later.
-    return;
+    // chlink: stay awake while the MIDI mode is BLE or USB, and for the first 20 s after boot (time for the Mac helper to open
+    // the serial port, which resets the ESP32, and to send `mode usb`). In light sleep the CPU is stopped (no timers, no
+    // tasks, no console input, no BLE); only a message from the FPGA wakes it. In the OFF mode this is the stock behaviour.
+    if (s_ChlinkKeepAwake || esp_timer_get_time() < 20LL * 1000000LL)
+    {
+        // Look again in a moment (the idle timer is one-shot). This runs in the timer service task: it must not block, so
+        // the block time is 0 (PwrMgr_IdleTimerPet waits forever, which a timer callback must never do).
+        if (IdleSystemTimer != NULL)
+        {
+            (void) xTimerReset(IdleSystemTimer, 0);
+        }
+        return;
+    }
 
     // Wait for the sleep task to start
     while(PwrMgrTaskHandle == NULL)
